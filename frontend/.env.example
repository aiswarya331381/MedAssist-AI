# ==========================================================
# MedAssist AI - Frontend Environment Variables
# Copy this file to ".env" and fill in your own Firebase values.
# These are safe to expose in the browser (standard Firebase web config).
# NEVER put OPENAI_API_KEY or OPENROUTER_API_KEY here.
# ==========================================================

REACT_APP_API_URL=http://localhost:5000

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
